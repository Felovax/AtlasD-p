{
  "name": "atlas-dap",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Interaktiv dåpsinvitasjon for Atlas – en liten historiebok fra skogen.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "node supabase/tests/rsvp.test.mjs",
    "photos": "node scripts/prepare-photos.mjs",
    "illustrations": "node scripts/render-illustrations.mjs",
    "check:mobile": "node scripts/mobile-check.mjs",
    "test:all": "npm test && npm run test:db"
  },
  "dependencies": {
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@supabase/supabase-js": "^2.117.3",
    "motion": "^14.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "playwright-core": "^1.64.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
