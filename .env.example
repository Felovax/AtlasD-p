# Kopier denne fila til .env.local for lokal utvikling (den blir IKKE sjekket inn i git).
#
# Begge verdiene finner du i Supabase: Project Settings → API (Data API / API Keys).
# Bruk ALDRI «service_role»- eller «secret»-nøkkelen her – den skal aldri ut i nettleseren.

# Prosjektets URL, f.eks. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=

# Offentlig nøkkel: «publishable key» (sb_publishable_...) eller den eldre «anon»-nøkkelen (eyJ...).
# Den er laget for å ligge i nettleseren; sikkerheten håndteres av databasen (RLS + funksjoner).
VITE_SUPABASE_PUBLISHABLE_KEY=

# Valgfritt: full adresse til nettsiden (brukes i forhåndsvisning når lenken deles).
# Settes automatisk av GitHub Actions ved publisering.
# VITE_SITE_URL=https://brukernavn.github.io/repo-navn/

# Kun for lokal testing av skjemaet uten database: sett til true for å simulere innsending.
# Virker bare med «npm run dev», aldri i en ferdig bygget side.
# VITE_RSVP_MOCK=true
